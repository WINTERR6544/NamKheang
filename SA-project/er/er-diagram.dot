digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [dir=both, color="#55606a", penwidth=1.1];
